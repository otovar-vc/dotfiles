[commit]
	gpgsign = true
[gpg]
	format = ssh
[gpg "ssh"]
{{- if eq .chezmoi.os "darwin" }}
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
{{- else if eq .chezmoi.os "linux" }}
	program = /opt/1Password/op-ssh-sign
{{- end }}
[url "git@github.com:vulncheck"]
	insteadOf = https://github.com/vulncheck
[user]
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIEbM6cVI+3Hnvjlb5QvVissJeqY2QCZGLhs9AXe3E9hp
	name = Oscar Tovar
	email = otovar@vulncheck.com
[maintenance]
	repo = ~/code/github.com/vulncheck/fetchsvc
	repo = ~/code/github.com/vulncheck/loadsvc
